{% types {
    cssID?: 'string',
    element_css_classes?: 'string',
    element_html_id?: 'string',
    class?: 'string',
    flare_css_classes?: 'string|string[]',
    html_class: 'string',
    html_id?: 'string',
} %}
{% set html_class = flare_str.htmlJoinClasses('block', element_css_classes ?? class ?? '', flare_css_classes ?? '') %}
{% set html_id = element_html_id ?? flare_str.htmlExtractId(cssID|default(null)) %}
<div class="{{ html_class|trim }}"{% if html_id is not empty %} id="{{ html_id }}"{% endif %}>
    {% block wrapper %}
        {% block headline %}
            {% if headline|default(false) and flare_str.formatHeadline(headline, false) %}
                {{ flare_str.formatHeadline(headline, true)|raw }}
            {% endif %}
        {% endblock %}
        {% block content %}
            {# === empty _flare_base content === #}
        {% endblock %}
        {% block footer %}
            {# === empty _flare_base footer === #}
        {% endblock %}
    {% endblock %}
</div>
